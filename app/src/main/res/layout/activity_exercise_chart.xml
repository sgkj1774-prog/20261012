<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="22sp"
            android:background="@android:color/transparent"
            android:textColor="#333333"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🏃 运动统计"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>
        <View android:layout_width="42dp" android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 汇总卡片：本月跑步 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FBE9E7"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月跑步"
                        android:textSize="12sp"
                        android:textColor="#E64A19"/>
                    <TextView
                        android:id="@+id/textRunKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#E64A19"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E3F2FD"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本月跑步时长"
                        android:textSize="12sp"
                        android:textColor="#1565C0"/>
                    <TextView
                        android:id="@+id/textRunMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#1565C0"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 汇总卡片：上月跑步 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FFF3E0"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上月跑步"
                        android:textSize="12sp"
                        android:textColor="#EF6C00"/>
                    <TextView
                        android:id="@+id/textLastMonthKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#EF6C00"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E1F5FE"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="上月跑步时长"
                        android:textSize="12sp"
                        android:textColor="#0277BD"/>
                    <TextView
                        android:id="@+id/textLastMonthMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#0277BD"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 汇总卡片：本年跑步 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#FCE4EC"
                    android:padding="14dp"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本年跑步"
                        android:textSize="12sp"
                        android:textColor="#C2185B"/>
                    <TextView
                        android:id="@+id/textYearKm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 km"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#C2185B"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="#E8EAF6"
                    android:padding="14dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="本年跑步时长"
                        android:textSize="12sp"
                        android:textColor="#303F9F"/>
                    <TextView
                        android:id="@+id/textYearMin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 min"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#303F9F"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 跑步距离折线图（近30天） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏃 跑步距离 (近30天)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChartRun"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@android:color/white"
                android:layout_marginBottom="16dp"/>

            <!-- 跑步时长折线图（近30天） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🏃 跑步时长 (近30天)"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginBottom="8dp"/>
            <com.github.mikephil.charting.charts.LineChart
                android:id="@+id/lineChartRunDur"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:background="@android:color/white"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
