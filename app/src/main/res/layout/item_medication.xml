<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/med_card_bg"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    android:paddingHorizontal="14dp"
    android:paddingVertical="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvMedName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#333333"/>

            <TextView
                android:id="@+id/tvMedDosage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textSize="11sp"
                android:textColor="#2196F3"
                android:background="#E3F2FD"/>

            <TextView
                android:id="@+id/tvBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="6dp"
                android:paddingVertical="1dp"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:background="#9E9E9E"
                android:visibility="gone"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvMedSchedule"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvMedCycle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#607D8B"
            android:visibility="gone"/>

        <TextView
            android:id="@+id/tvMedDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#666666"/>

        <TextView
            android:id="@+id/tvMedExpiry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <TextView
            android:id="@+id/tvMedNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="#999999"/>

        <TextView
            android:id="@+id/tvMedStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="12sp"
            android:textColor="#999999"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:text="✎ 编辑"
            android:textSize="13sp"
            android:textColor="#2196F3"
            android:backgroundTint="#E3F2FD"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>

        <Button
            android:id="@+id/btnTake"
            android:layout_width="80dp"
            android:layout_height="36dp"
            android:layout_marginTop="8dp"
            android:text="标记已服"
            android:textSize="13sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#BDBDBD"
            android:insetTop="0dp"
            android:insetBottom="0dp"/>
    </LinearLayout>
</LinearLayout>
