<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="22sp"
            android:background="@android:color/transparent"
            android:textColor="#333333"/>
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="数据管理"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>
        <View
            android:layout_width="42dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 导入数据 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📥 导入数据"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="从备份文件恢复全部数据（记录 + 成员配置）"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="12dp"/>
                <Button
                    android:id="@+id/btnImportCsv"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📄 导入 CSV 文件"
                    android:backgroundTint="#FF9800"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:id="@+id/btnImportExcel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📊 导入 Excel (XLSX) 文件"
                    android:backgroundTint="#9C27B0"
                    android:layout_marginBottom="12dp"/>
                <ProgressBar
                    android:id="@+id/progressBarImport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/textStatusImport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- 导出数据 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📤 导出数据"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="4dp"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="将全部数据（记录 + 成员配置）备份到指定位置"
                    android:textSize="12sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="12dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📂 保存位置"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="6dp"/>
                <TextView
                    android:id="@+id/textViewFolderPath"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="未选择目录"
                    android:textSize="13sp"
                    android:textColor="#999999"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:id="@+id/btnSelectFolder"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="📁 选择保存位置"
                    android:backgroundTint="#757575"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnExportCsv"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📄 导出为 CSV"
                    android:backgroundTint="#4CAF50"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:id="@+id/btnExportExcel"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📊 导出为 Excel (XLSX)"
                    android:backgroundTint="#2196F3"
                    android:layout_marginBottom="12dp"/>
                <ProgressBar
                    android:id="@+id/progressBarExport"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:visibility="gone"/>
                <TextView
                    android:id="@+id/textStatusExport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="请先选择保存位置"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- 数据重置 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ 数据安全"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="重置将清空所有数据（记录/成员/设置），操作不可恢复。"
                    android:textSize="13sp"
                    android:textColor="#E53935"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:id="@+id/btnResetData"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="🗑️ 数据重置"
                    android:backgroundTint="#E53935"/>
            </LinearLayout>

            <!-- 成员管理 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 成员管理"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="管理成员信息（姓名、颜色）"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:layout_marginBottom="10dp"/>
                <Button
                    android:id="@+id/btnMemberManagement"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="👥 成员管理"
                    android:backgroundTint="#607D8B"/>
            </LinearLayout>

            <!-- 关于 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="16dp"
                android:elevation="1dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ℹ️ 关于"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:layout_marginBottom="12dp"/>
                <Button
                    android:id="@+id/btnVersionInfo"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="📋 查看版本信息"
                    android:backgroundTint="#607D8B"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
