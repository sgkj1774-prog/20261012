<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- 顶部导航栏（箭头 + 小月份） -->
    <LinearLayout
        android:id="@+id/headerMonth"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:background="#FFFFFF">

        <ImageButton android:id="@+id/btnPrev"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@android:drawable/ic_media_previous"
            android:background="@android:color/transparent"
            android:contentDescription="上月"/>

        <!-- 导航栏内小月份（保持紧凑，不遮挡大标题视觉重心） -->
        <TextView android:id="@+id/tvMonth"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2024年 7月"
            android:textSize="13sp"
            android:textColor="#888888"
            android:gravity="center"/>

        <ImageButton android:id="@+id/btnNext"
            android:layout_width="32dp" android:layout_height="32dp"
            android:src="@android:drawable/ic_media_next"
            android:background="@android:color/transparent"
            android:contentDescription="下月"/>
    </LinearLayout>

    <!-- 月份大标题（自然月导航核心，20sp 粗体） -->
    <TextView
        android:id="@+id/tvMonthBig"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2024年 7月"
        android:textSize="20sp"
        android:textColor="#222222"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:background="#FFFFFF"/>

    <!-- 星期标题行（一二三四五六日） -->
    <LinearLayout
        android:id="@+id/headerDays"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:background="#FAFAFA"
        android:paddingHorizontal="4dp"/>

    <!-- 日期网格（7列，行数动态） -->
    <GridLayout
        android:id="@+id/gridDays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="7"
        android:rowCount="6"
        android:background="#FFFFFF"
        android:paddingHorizontal="4dp"
        android:paddingBottom="4dp"/>

    <!-- 无数据提示 -->
    <TextView android:id="@+id/tvNoRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="本月暂无记录"
        android:textSize="12sp"
        android:textColor="#BBBBBB"
        android:gravity="center"
        android:paddingVertical="8dp"
        android:background="#FFFFFF"
        android:visibility="gone"/>

</LinearLayout>
