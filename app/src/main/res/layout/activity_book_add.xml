<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="22sp"
            android:background="@android:color/transparent"
            android:textColor="#333333"/>
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📖 添加读书记录"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>
        <View
            android:layout_width="42dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 书名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="书名 *"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/editTitle"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="请输入书名"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:layout_marginBottom="12dp"/>

            <!-- 作者 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="作者（可选）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/editAuthor"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="请输入作者"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:singleLine="true"
                android:layout_marginBottom="12dp"/>

            <!-- 页数 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginEnd="8dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总页数"
                        android:textSize="13sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editTotalPages"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="如：300"
                        android:background="@android:color/white"
                        android:paddingHorizontal="12dp"
                        android:textSize="15sp"
                        android:inputType="number"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="当前页数"
                        android:textSize="13sp"
                        android:textColor="#999999"
                        android:layout_marginBottom="4dp"/>
                    <EditText
                        android:id="@+id/editCurrentPage"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="如：50"
                        android:background="@android:color/white"
                        android:paddingHorizontal="12dp"
                        android:textSize="15sp"
                        android:inputType="number"/>
                </LinearLayout>
            </LinearLayout>

            <!-- 开始阅读时间（v12 新增，精确到时分） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始阅读时间（可选）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <Button
                    android:id="@+id/btnStartDate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="📅 开始日期"
                    android:textSize="15sp"
                    android:backgroundTint="#FF9800"
                    android:layout_marginEnd="8dp"/>
                <Button
                    android:id="@+id/btnStartTime"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="🕐 开始时间"
                    android:textSize="15sp"
                    android:backgroundTint="#FF9800"/>
            </LinearLayout>

            <!-- 进度提示 -->
            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="阅读进度：0%"
                android:textSize="13sp"
                android:textColor="#FF9800"
                android:layout_marginBottom="12dp"
                android:visibility="gone"/>

            <!-- 状态 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="状态"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <Spinner
                android:id="@+id/spinnerStatus"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="12dp"/>

            <!-- 评分 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我的评分（点击星星选择）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:id="@+id/layoutStars"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">
                <TextView
                    android:id="@+id/star1"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:textColor="@color/star_inactive"/>
                <TextView
                    android:id="@+id/star2"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:textColor="@color/star_inactive"/>
                <TextView
                    android:id="@+id/star3"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:textColor="@color/star_inactive"/>
                <TextView
                    android:id="@+id/star4"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:textColor="@color/star_inactive"/>
                <TextView
                    android:id="@+id/star5"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:text="☆"
                    android:textSize="32sp"
                    android:gravity="center"
                    android:textColor="@color/star_inactive"/>
            </LinearLayout>

            <!-- 整本读后感 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="整本读后感（可选）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <EditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:hint="写下你的读后感..."
                android:background="@android:color/white"
                android:padding="12dp"
                android:textSize="15sp"
                android:gravity="top"
                android:layout_marginBottom="16dp"/>

            <!-- 分段读后感：每条绑定一个页面区间 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="分段读后感（按页面区间）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="6dp"/>
            <LinearLayout
                android:id="@+id/layoutBookNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@android:color/white"
                android:padding="8dp"
                android:layout_marginBottom="8dp"/>
            <Button
                android:id="@+id/btnAddBookNote"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="➕ 添加段落读后感"
                android:textSize="15sp"
                android:backgroundTint="#FFB74D"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="💾 保存记录"
                android:textSize="17sp"
                android:textStyle="bold"
                android:backgroundTint="#FF9800"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
