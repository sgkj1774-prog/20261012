<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 顶部栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp"
        android:background="#FFFFFF"
        android:elevation="2dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:text="←"
            android:textSize="22sp"
            android:background="@android:color/transparent"
            android:textColor="#333333"/>

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💊 新增药品"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center"/>

        <View
            android:layout_width="42dp"
            android:layout_height="1dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 药品名 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="药品名 *"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="如：优甲乐"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 剂量 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="每次剂量"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editDosage"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="如：50μg、1片"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 服用时段 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服用时段"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <Spinner
                android:id="@+id/spinnerTiming"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:layout_marginBottom="14dp"/>

            <!-- 具体时间（可选） -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="具体服用时间（可选）"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/textTime"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="未设置"
                android:background="@android:color/white"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:textColor="#333333"
                android:layout_marginBottom="4dp"/>
            <TextView
                android:id="@+id/btnClearTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="清除时间"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:layout_marginBottom="14dp"/>

            <!-- 备注 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备注"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editNotes"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:hint="如：空腹服用，服后半小时再吃早饭"
                android:background="@android:color/white"
                android:padding="12dp"
                android:textSize="15sp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="20dp"/>

            <!-- ================= 药品包装信息（选填） ================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="药品包装信息（选填）"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2196F3"
                android:layout_marginBottom="10dp"/>

            <!-- 生产日期 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="药品生产日期"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/textProductionDate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="点击选择"
                    android:background="@android:color/white"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="#999999"/>

                <TextView
                    android:id="@+id/btnClearProduction"
                    android:layout_width="48dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="清除"
                    android:textSize="12sp"
                    android:textColor="#2196F3"/>
            </LinearLayout>

            <!-- 有效期至 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="有效期至"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <TextView
                    android:id="@+id/textExpiryDate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:text="点击选择"
                    android:background="@android:color/white"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:textSize="15sp"
                    android:textColor="#999999"/>

                <TextView
                    android:id="@+id/btnClearExpiry"
                    android:layout_width="48dp"
                    android:layout_height="50dp"
                    android:gravity="center"
                    android:text="清除"
                    android:textSize="12sp"
                    android:textColor="#2196F3"/>
            </LinearLayout>

            <!-- 规格 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="规格"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editSpec"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="如：50μg×100片"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 批准文号 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="批准文号"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editApprovalNo"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="如：国药准字H20100523"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 上市许可持有人 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上市许可持有人"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editMah"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="如：默克制药（江苏）有限公司"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 生产厂 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="生产厂"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editManufacturer"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="药品生产企业名称"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 包装厂 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="包装厂"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editPacker"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:hint="药品包装企业名称"
                android:background="@android:color/white"
                android:paddingHorizontal="12dp"
                android:textSize="15sp"
                android:inputType="text"
                android:layout_marginBottom="14dp"/>

            <!-- 企业地址 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="企业地址"
                android:textSize="13sp"
                android:textColor="#999999"
                android:layout_marginBottom="4dp"/>
            <EditText
                android:id="@+id/editCompanyAddress"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:hint="生产企业注册地址"
                android:background="@android:color/white"
                android:padding="12dp"
                android:textSize="15sp"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:layout_marginBottom="20dp"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="保存"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#2196F3"/>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
