<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <application
        android:name=".HealthApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.HealthRecorder">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:name=".AddRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".ChartActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".DataManagementActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".RecordListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".DayDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".UserManagementActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".VersionHistoryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <!-- 新增读书笔记 -->
        <activity
            android:name=".book.BookListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".book.BookAddActivity"
            android:exported="false"
            android:parentActivityName=".book.BookListActivity"/>
        <activity
            android:name=".book.BookStatsActivity"
            android:exported="false"
            android:parentActivityName=".book.BookListActivity"/>
        <activity
            android:name=".breathing.BreathingStatsActivity"
            android:exported="false"
            android:parentActivityName=".breathing.BreathingListActivity"/>
        <!-- 猫咪主页（🐱 猫 按钮入口，Tab 切换猫拉屎/猫刷牙） -->
        <activity
            android:name=".cat.CatHomeActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <!-- 新增猫咪如厕记录 -->
        <activity
            android:name=".cat.CatRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".cat.CatRecordListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".cat.CatStatsActivity"
            android:exported="false"
            android:parentActivityName=".cat.CatRecordListActivity"/>
        <!-- 新增猫粮记录 -->
        <activity
            android:name=".cat.CatFoodListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".cat.CatFoodAddActivity"
            android:exported="false"
            android:parentActivityName=".cat.CatFoodListActivity"/>
        <!-- 新增刷牙记录 -->
        <activity
            android:name=".teeth.TeethRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".teeth.TeethRecordListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".teeth.TeethChartActivity"
            android:exported="false"
            android:parentActivityName=".teeth.TeethRecordListActivity"/>
        <!-- 新增运动记录 -->
        <activity
            android:name=".exercise.ExerciseRecordActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".exercise.ExerciseRecordListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".exercise.ExerciseChartActivity"
            android:exported="false"
            android:parentActivityName=".exercise.ExerciseRecordListActivity"/>
        <!-- 新增呼吸打卡 -->
        <activity
            android:name=".breathing.BreathingListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".breathing.BreathingAddActivity"
            android:exported="false"
            android:parentActivityName=".breathing.BreathingListActivity"/>
        <!-- 重要事项 -->
        <activity
            android:name=".event.EventListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"/>
        <activity
            android:name=".event.EventStatsActivity"
            android:exported="false"
            android:parentActivityName=".event.EventListActivity"/>
        <activity
            android:name=".event.EventAddActivity"
            android:exported="false"
            android:parentActivityName=".event.EventListActivity"/>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
    </application>
</manifest>
